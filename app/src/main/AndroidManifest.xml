<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Coen390Project">

        <!-- Login screen: first screen when app opens -->
        <activity
            android:name=".LoginActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Account registration -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false" />

        <!-- Main dashboard -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".MyOwnWorkouts"
            android:exported="false" />

        <activity
            android:name=".HeartRateActivity"
            android:exported="false" />

        <activity
            android:name=".ExerciseListActivity"
            android:exported="false" />

        <activity
            android:name=".WorkoutSessionActivity"
            android:exported="false" />
        <activity
            android:name=".Option1Activity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".Option2Activity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".Option3Activity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".Option4Activity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".Option5Activity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

    </application>

</manifest>
