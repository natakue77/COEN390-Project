<?xml version="1.0" encoding="utf-8"?>


<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111214">

    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#111214">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/optionToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#111214"
            android:elevation="4dp"
            app:title="Progress &amp; Analytics"
            app:titleTextColor="#FFFFFF" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- WORKOUT PROGRESS HEADING AND RESET BUTTON -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Workout Progress"
                        android:textSize="21sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />

                    <Button
                        android:id="@+id/btnResetWorkouts"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="Reset"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#D32F2F" />

                </LinearLayout>

                <!-- WORKOUT SELECTION -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/body_focus_card"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Selected Workout"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <Button
                        android:id="@+id/btnSelectWorkout"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="Choose a Workout"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:backgroundTint="#D32F2F"
                        android:visibility="visible" />

                    <TextView
                        android:id="@+id/tvSelectedWorkout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No workout selected"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:padding="12dp"
                        android:background="#202329"
                        android:layout_marginTop="4dp"
                        android:visibility="gone" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Timeline"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="6dp" />

                    <Spinner
                        android:id="@+id/timelineSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:backgroundTint="#EF5350"
                        android:popupBackground="#292D35" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Graph Variable"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="6dp" />

                    <Spinner
                        android:id="@+id/variableSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:backgroundTint="#EF5350"
                        android:popupBackground="#292D35" />

                </LinearLayout>

                <!-- WORKOUT GRAPH -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/body_focus_card"
                    android:padding="16dp"
                    android:layout_marginBottom="28dp">

                    <TextView
                        android:id="@+id/tvWorkoutGraphTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Workout Performance"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <com.example.coen390project.ProgressGraphView
                        android:id="@+id/workoutGraph"
                        android:layout_width="match_parent"
                        android:layout_height="240dp"
                        android:background="#202329" />

                </LinearLayout>

                <!-- GOAL ANALYTICS -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Goal Analytics"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/body_focus_card"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Goal Type"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Goal Workout"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="6dp" />

                    <Spinner
                        android:id="@+id/goalWorkoutSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:backgroundTint="#8F95A1"
                        android:spinnerMode="dropdown" />

                    <Spinner
                        android:id="@+id/goalTypeSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:backgroundTint="#EF5350"
                        android:popupBackground="#292D35" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Target Value"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="6dp" />

                    <EditText
                        android:id="@+id/goalEditText"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:hint="Enter target"
                        android:inputType="numberDecimal"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#8F95A1"
                        android:backgroundTint="#EF5350"
                        android:padding="10dp" />

                    <Button
                        android:id="@+id/saveGoalButton"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="Save Goal"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:backgroundTint="#D32F2F"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/goalDescriptionTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Choose a workout and set a goal."
                        android:textColor="#8F95A1"
                        android:textSize="14sp" />

                </LinearLayout>

                <!-- GOAL GRAPH -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/body_focus_card"
                    android:padding="16dp"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:id="@+id/tvGoalGraphTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Goal Progress"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <com.example.coen390project.ProgressGraphView
                        android:id="@+id/goalGraph"
                        android:layout_width="match_parent"
                        android:layout_height="240dp"
                        android:background="#202329" />

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#292D35"
        app:menu="@menu/drawer_menu"
        app:itemTextColor="@color/drawer_item_colors"
        app:itemIconTint="@color/drawer_item_colors"
        app:itemBackground="@drawable/drawer_item_background" />

</androidx.drawerlayout.widget.DrawerLayout>
