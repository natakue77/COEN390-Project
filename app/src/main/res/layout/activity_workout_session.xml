<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <TextView
        android:id="@+id/exerciseNameText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Exercise Name"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/workoutStatusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Ready"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/repCountText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="0 Reps"
        android:textSize="40sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/learnMovementButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Learn Movement" />

    <Button
        android:id="@+id/finishLearningButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Finish Learning" />

    <Button
        android:id="@+id/startWorkoutButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start Workout" />

    <Button
        android:id="@+id/finishWorkoutButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Finish Workout" />

</LinearLayout>
