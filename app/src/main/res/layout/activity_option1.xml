<?xml version="1.0" encoding="utf-8"?>


<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111214">

    <!-- MAIN SCREEN -->
    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#111214">

        <!-- TOOLBAR -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/optionToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#111214"
            android:elevation="4dp"
            app:title="Workouts"
            app:titleTextColor="#FFFFFF" />

        <!-- SCROLLABLE CONTENT -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- SECTION TITLE -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Body Focus"
                    android:textColor="#FFFFFF"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <!-- BODY FOCUS GRID -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:rowCount="5"
                    android:layout_marginTop="16dp"
                    android:alignmentMode="alignMargins"
                    android:useDefaultMargins="false">

                    <!-- ABS -->
                    <LinearLayout
                        android:id="@+id/cardAbs"
                        android:layout_width="0dp"
                        android:layout_height="155dp"
                        android:layout_columnWeight="1"
                        android:layout_marginEnd="7dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/body_focus_card"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="10dp">

                        <ImageView
                            android:layout_width="129dp"
                            android:layout_height="96dp"
                            android:contentDescription="Abs"
                            android:rotation="0"
                            android:scaleType="fitCenter"
                            android:src="@drawable/img_abs"
                            android:translationX="-5dp"
                            android:translationY="0dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Abs and Core"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:gravity="center" />

                    </LinearLayout>

                    <!-- BACK -->
                    <LinearLayout
                        android:id="@+id/cardBack"
                        android:layout_width="0dp"
                        android:layout_height="155dp"
                        android:layout_columnWeight="1"
                        android:layout_marginStart="7dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/body_focus_card"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="10dp">

                        <ImageView
                            android:layout_width="166dp"
                            android:layout_height="104dp"
                            android:contentDescription="Back"
                            android:rotation="0"
                            android:scaleType="fitCenter"
                            android:src="@drawable/img_back"
                            android:translationX="0dp"
                            android:translationY="0dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Back"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:gravity="center" />

                    </LinearLayout>

                    <!-- CHEST -->
                    <LinearLayout
                        android:id="@+id/cardChest"
                        android:layout_width="0dp"
                        android:layout_height="155dp"
                        android:layout_columnWeight="1"
                        android:layout_marginEnd="7dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/body_focus_card"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="10dp">

                        <ImageView
                            android:layout_width="119dp"
                            android:layout_height="89dp"
                            android:contentDescription="Chest"
                            android:rotation="0"
                            android:scaleType="fitCenter"
                            android:src="@drawable/img_chest"
                            android:translationX="-1dp"
                            android:translationY="0dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Chest"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:gravity="center" />

                    </LinearLayout>

                    <!-- SHOULDERS -->
                    <LinearLayout
                        android:id="@+id/cardShoulders"
                        android:layout_width="0dp"
                        android:layout_height="155dp"
                        android:layout_columnWeight="1"
                        android:layout_marginStart="7dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/body_focus_card"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="10dp">

                        <ImageView
                            android:layout_width="101dp"
                            android:layout_height="98dp"
                            android:contentDescription="Shoulders"
                            android:rotation="0"
                            android:scaleType="fitCenter"
                            android:src="@drawable/img_shoulder"
                            android:translationX="-1dp"
                            android:translationY="0dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Shoulders"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:gravity="center" />

                    </LinearLayout>

                    <!-- LEGS -->
                    <LinearLayout
                        android:id="@+id/cardLegs"
                        android:layout_width="0dp"
                        android:layout_height="155dp"
                        android:layout_columnWeight="1"
                        android:layout_marginEnd="7dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/body_focus_card"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="10dp">

                        <ImageView
                            android:layout_width="79dp"
                            android:layout_height="91dp"
                            android:contentDescription="Legs"
                            android:rotation="0"
                            android:scaleType="fitCenter"
                            android:src="@drawable/img_legs"
                            android:translationX="1dp"
                            android:translationY="0dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Legs"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:gravity="center" />

                    </LinearLayout>

                    <!-- FOREARMS -->
                    <LinearLayout
                        android:id="@+id/cardForearm"
                        android:layout_width="0dp"
                        android:layout_height="155dp"
                        android:layout_columnWeight="1"
                        android:layout_marginStart="7dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/body_focus_card"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="10dp">

                        <ImageView
                            android:layout_width="133dp"
                            android:layout_height="102dp"
                            android:contentDescription="Forearms"
                            android:rotation="0"
                            android:scaleType="fitCenter"
                            android:src="@drawable/img_forearm"
                            android:translationX="0dp"
                            android:translationY="0dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Forearms"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:gravity="center" />

                    </LinearLayout>

                    <!-- BICEPS -->
                    <LinearLayout
                        android:id="@+id/cardBiceps"
                        android:layout_width="0dp"
                        android:layout_height="155dp"
                        android:layout_columnWeight="1"
                        android:layout_marginEnd="7dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/body_focus_card"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="10dp">

                        <ImageView
                            android:layout_width="104dp"
                            android:layout_height="90dp"
                            android:contentDescription="Biceps"
                            android:rotation="0"
                            android:scaleType="fitCenter"
                            android:src="@drawable/img_bicep"
                            android:translationX="2.5dp"
                            android:translationY="0dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="Biceps"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- TRICEPS -->
                    <LinearLayout
                        android:id="@+id/cardTriceps"
                        android:layout_width="0dp"
                        android:layout_height="155dp"
                        android:layout_columnWeight="1"
                        android:layout_marginStart="7dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/body_focus_card"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="10dp">

                        <ImageView
                            android:layout_width="91dp"
                            android:layout_height="100dp"
                            android:contentDescription="Triceps"
                            android:rotation="0"
                            android:scaleType="fitCenter"
                            android:src="@drawable/img_tri"
                            android:translationX="2dp"
                            android:translationY="0dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Triceps"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:gravity="center" />

                    </LinearLayout>

                    <!-- MY OWN WORKOUTS -->
                    <LinearLayout
                        android:id="@+id/cardMyOwnWorkouts"
                        android:layout_width="0dp"
                        android:layout_height="155dp"
                        android:layout_columnWeight="1"
                        android:layout_marginEnd="7dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/body_focus_card"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+"
                            android:textColor="#FFFFFF"
                            android:textSize="62sp"
                            android:fontFamily="sans"
                            android:textStyle="normal"
                            android:includeFontPadding="false" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="My Own Workouts"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:gravity="center" />

                    </LinearLayout>

                </GridLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

    <!-- NAVIGATION DRAWER -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#292D35"
        app:menu="@menu/drawer_menu"
        app:itemTextColor="@color/drawer_item_colors"
        app:itemIconTint="@color/drawer_item_colors"
        app:itemBackground="@drawable/drawer_item_background" />

</androidx.drawerlayout.widget.DrawerLayout>
