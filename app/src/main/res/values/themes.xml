<?xml version="1.0" encoding="utf-8"?>

<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="WorkoutCategoryButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:background">@drawable/workout_button</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:elevation">3dp</item>
    </style>

    <style name="Base.Theme.Coen390Project"
        parent="Theme.Material3.DayNight.NoActionBar">

        <item name="android:windowBackground">#111214</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#B0B0B0</item>
        <item name="android:colorAccent">#8F95A1</item>

        <item name="colorPrimary">#8F95A1</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#8F95A1</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSurface">#292D35</item>
        <item name="colorOnSurface">#FFFFFF</item>

    </style>

    <style name="DarkSpinner">
        <item name="android:background">@drawable/spinner_background</item>
        <item name="android:popupBackground">#292D35</item>
        <item name="android:spinnerMode">dropdown</item>
        <item name="android:dropDownVerticalOffset">4dp</item>
    </style>


    <style name="Theme.Coen390Project"
        parent="Base.Theme.Coen390Project" />

</resources>
